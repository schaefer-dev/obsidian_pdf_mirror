<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by install.sh into ~/Library/LaunchAgents; placeholders are __LIKE_THIS__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>--quiet</string>
    <string>__PROJECT__/mirror.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <!-- Every 15 min; intervals missed during sleep are coalesced into one run on wake. -->
  <key>StartInterval</key>
  <integer>__INTERVAL__</integer>
  <key>RunAtLoad</key>
  <true/>
  <!-- Low priority: efficiency cores, throttled I/O. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT__/.state/mirror.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/.state/mirror.log</string>
</dict>
</plist>
